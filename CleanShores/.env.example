# CleanShores Environment Configuration
SECRET_KEY=cleanshores-secure-eco-secret-key-2026
FLASK_ENV=development
FLASK_DEBUG=1

# MySQL Database Configuration
# Option 1: Full Database URL (supports mysql+pymysql:// or mysql://)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/cleanshores_db

# Option 2: Individual MySQL variables (used when DATABASE_URL is omitted)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=cleanshores_db

# SMTP Email Configuration (Optional - falls back to dev logger/Ethereal)
SMTP_SERVER=smtp.ethereal.email
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
MAIL_DEFAULT_SENDER="CleanShores Platform <noreply@cleanshores.org>"
MAIL_DEV_MODE=True
